// ==============================================================================
// fedora-multishell: config/desktop/niri/shells/inir.kdl
// Configuração Oficial e Modular do iNiR Shell v3.x (Quickshell)
// ==============================================================================

// ------------------------------------------------------------------------------
// Inicialização da Shell (Necessário no Multi-Shell, pois inir.service está desativado)
// ------------------------------------------------------------------------------
spawn-at-startup "inir" "run"

// ------------------------------------------------------------------------------
// Configurações Específicas de Hardware e Preferências Pessoais
// ------------------------------------------------------------------------------
output "eDP-1" {
    scale 1.25
    variable-refresh-rate on-demand=true
}

input {
    keyboard {
        numlock
    }
}

// ------------------------------------------------------------------------------
// Configurações Globais da Raiz do iNiR (Extraídas do config.kdl original)
// ------------------------------------------------------------------------------
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

debug {
    honor-xdg-activation-with-invalid-serial
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Regra defensiva contra janelas de streaming
window-rule {
    match app-id=r#"(?i).*xwaylandvideobridge.*"#
    match title=r#"(?i).*xwaylandvideobridge.*"#
    open-floating true
    default-floating-position x=-500 y=-500 relative-to="top-left"
    opacity 0.0
}

// ------------------------------------------------------------------------------
// Inclusões Modulares Oficiais do iNiR (Carrega 100% da suíte na ordem correta)
// ------------------------------------------------------------------------------
include "../config.d/10-input-and-cursor.kdl"
include "../config.d/20-layout-and-overview.kdl"
include "../config.d/30-window-rules.kdl"
include "../config.d/40-environment.kdl"
include "../config.d/50-startup.kdl"
include "../config.d/60-animations.kdl"
include "../config.d/70-binds.kdl"
include "../config.d/80-layer-rules.kdl"
include "../config.d/90-user-extra.kdl"
