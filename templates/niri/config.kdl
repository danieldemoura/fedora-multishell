// Configuração do niri convertida a partir da config do Umbriel.
// Copie para ~/.config/niri/config.kdl e valide com `niri validate`.
//
// Itens SEM equivalente no niri (marcados com "SEM EQUIVALENTE"):
//   scratchpad, pinned windows, HDR, efeitos de borda, tab bar customizável,
//   "Mod" sozinho como atalho, blur (depende da versão do niri).

// ==============================================================================
// Inicialização
// ==============================================================================
spawn-at-startup "noctalia"

// XWayland: o niri não tem XWayland embutido. Instale `xwayland-satellite`
// e deixe no PATH (niri >= 25.08 inicia automaticamente).

// ==============================================================================
// Entrada
// ==============================================================================
input {
    keyboard {
        xkb {
            layout "br"
        }
        numlock
    }

    // focus-follows-mouse max-scroll-amount="0%"

    // touch {
    //     map-to-output "eDP-1"
    // }
}

// ==============================================================================
// Monitores
// ==============================================================================
// Veja os nomes com `niri msg outputs`.
output "eDP-1" {
    scale 1.25
    // vrr "fullscreen" do Umbriel ≈ on-demand no niri
    variable-refresh-rate on-demand=true
    // hdr = "auto": SEM EQUIVALENTE
}

// ==============================================================================
// Eventos de tampa (lid)
// ==============================================================================
// switch-events {
//     lid-close { spawn "niri" "msg" "output" "eDP-1" "off"; }
//     lid-open  { spawn "niri" "msg" "output" "eDP-1" "on"; }
// }

// ==============================================================================
// Layout
// ==============================================================================
layout {
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
}

// ==============================================================================
// Hot corner
// ==============================================================================
// O canto superior esquerdo abre o overview por padrão no niri
// (o delay de 500ms não é configurável).
// gestures {
//     hot-corners {
//         top-left
//     }
// }

// ==============================================================================
// Regras de janela
// ==============================================================================

// Opacidade global (no Umbriel vinha junto com blur)
window-rule {
    // opacity 0.87
}

window-rule {
    match app-id="^dev.noctalia.Noctalia$"
    open-floating true
    default-column-width { fixed 1020; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id="^dev.noctalia.UmbrielSharePicker$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match title="^(Picture-in-Picture|Picture in picture)$"
    open-floating true
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

window-rule {
    match title="^notificationtoasts_.+_desktop"
    open-floating true
    open-focused false
    default-floating-position x=0 y=0 relative-to="bottom-right"
    // default_pinned: SEM EQUIVALENTE
}

// ==============================================================================
// Blur (só em versões recentes do niri com suporte a background-effect;
// confira a documentação da sua versão antes de ativar)
// ==============================================================================
// window-rule {
//     background-effect { blur true; }
// }
//
// layer-rule {
//     match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|desktop-widget-[^\"]*)$"
//     background-effect { blur true; }
// }

// ==============================================================================
// Atalhos
// ==============================================================================
binds {
    // --- Aplicativos e sessão ---
    Mod+Return repeat=false { spawn "kitty"; }
    // "Mod" sozinho não é suportado no niri; usando Mod+D para o launcher
    Mod+space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+Escape allow-inhibiting=false repeat=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Energia e sessão ---
    Mod+Escape { quit; }
    Mod+Shift+Delete { spawn "systemctl" "poweroff"; }
    Mod+Ctrl+Delete { spawn "systemctl" "reboot"; }

    // --- Foco e movimento ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { spawn "noctalia" "msg" "session" "lock"; }
    // window-focus-next: aproximado
    Mod+F1 { focus-column-right-or-first; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // --- Estado da janela e layout ---
    Mod+T repeat=false { toggle-window-floating; }
    Mod+Shift+T repeat=false { switch-focus-between-floating-and-tiling; }
    // Mod+P (pinned): SEM EQUIVALENTE
    Mod+M repeat=false { maximize-window-to-edges; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+Ctrl+F repeat=false { maximize-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+W repeat=false { toggle-column-tabbed-display; }
    // Em coluna com abas, focus-window-up/down troca de aba
    Mod+Alt+Right { focus-window-down; }
    Mod+Alt+Left  { focus-window-up; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+O repeat=false { toggle-overview; }

    // --- Workspaces (teclado numérico) ---
    Mod+KP_1 { focus-workspace 1; }
    Mod+KP_2 { focus-workspace 2; }
    Mod+KP_3 { focus-workspace 3; }
    Mod+KP_4 { focus-workspace 4; }
    Mod+KP_5 { focus-workspace 5; }
    Mod+KP_6 { focus-workspace 6; }
    Mod+KP_7 { focus-workspace 7; }
    Mod+KP_8 { focus-workspace 8; }
    Mod+KP_9 { focus-workspace 9; }

    Mod+Ctrl+KP_1 { move-window-to-workspace 1; }
    Mod+Ctrl+KP_2 { move-window-to-workspace 2; }
    Mod+Ctrl+KP_3 { move-window-to-workspace 3; }
    Mod+Ctrl+KP_4 { move-window-to-workspace 4; }
    Mod+Ctrl+KP_5 { move-window-to-workspace 5; }
    Mod+Ctrl+KP_6 { move-window-to-workspace 6; }
    Mod+Ctrl+KP_7 { move-window-to-workspace 7; }
    Mod+Ctrl+KP_8 { move-window-to-workspace 8; }
    Mod+Ctrl+KP_9 { move-window-to-workspace 9; }

    // --- Scratchpad: SEM EQUIVALENTE no niri ---
    // (Mod+Shift+Space / Mod+Space / Mod+Ctrl+Space / Mod+Tab removidos)

    // --- Áudio ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // --- Brilho ---
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // --- Captura de tela ---
    Print { spawn "noctalia" "msg" "screenshot-region"; }
}
